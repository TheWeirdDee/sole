# Copy to .env.local (gitignored) and fill in. Never commit real values.

# Starknet mainnet RPC. Create a free key at https://www.alchemy.com,
# then use: https://starknet-mainnet.g.alchemy.com/v2/<YOUR_ALCHEMY_KEY>
STARKNET_RPC=

# Same value, exposed to the browser for apps/web (Next.js requires the
# NEXT_PUBLIC_ prefix for anything read client-side).
NEXT_PUBLIC_STARKNET_RPC=

# Deployed mainnet addresses (public - see evidence/deployment.json). Safe
# to commit; not secrets.
NEXT_PUBLIC_REGISTRY_ADDR=0x057a4c75612430dae3a79485c41a53f986c42526df59af4f73485cde56be6f4c
NEXT_PUBLIC_ANONYMIZER_ADDR=0x01ddb10db13096b973a9a63d02f5e9a6370d3b592cd6ca02a91f5729ca685c74
NEXT_PUBLIC_POOL_ADDR=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a
NEXT_PUBLIC_ADAPTER_ADDR=0x0788f8439042f8750ec90638bc764dd36f766930770238c630df70e667e6cf28
NEXT_PUBLIC_ADAPTER_VENUE_2_ADDR=0x01dbf93d533f9b1d4aff959cfd10cd53136663db81f101d74db8008825b6d27c
